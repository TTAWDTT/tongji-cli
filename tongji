            page = context.pages[0] if context.pages else context.new_page()
            if interactive:
                page.bring_to_front()
            for site in sites:
                if interactive:
                    print(f"正在打开 {site} 的学校页面，请在浏览器内完成认证。", file=sys.stderr, flush=True)
                try:
                    state = visit(page, site, interactive)
                    entry = {"status": state}
                    if state == "authenticated" and args.command not in {"login", "status"}:
                        output = site_items(args, site, context, page, now)
                        if isinstance(output, dict):
                            entry.update(output)
                        else:
                            entry["items"] = output
                    results[site] = entry
                except (Error, AssertionError, QueryUnavailable, OSError, ValueError, KeyError, TypeError) as error:
                    if page.is_closed():
                        raise
                    results[site] = failure(error)
        finally:
            context.close()
    if interactive and any(entry["status"] == "authenticated" for entry in results.values()):
        check = subprocess.run(
            [sys.executable, str(Path(__file__).resolve()), "status", *(["--site", site_filter] if site_filter else []), "--json"],
            capture_output=True, text=True,
        )
        if check.stdout.strip():
            restarted = json.loads(check.stdout)
        else:
            restarted = {}
        for site, entry in results.items():
            entry["after_restart"] = restarted.get(site, {}).get("status", "unverified")
    return results


def display(results, as_json):
    if as_json:
        print(json.dumps(results, ensure_ascii=False))
    else:
        for site, entry in results.items():
            print(f"{site}: {entry['status']}")
            if "after_restart" in entry:
                print(f"重开专用浏览器后: {entry['after_restart']}")
            if "detail" in entry:
                print(entry["detail"])
            if "items" in entry:
                print(f"共 {len(entry['items'])} 项")
                for item in entry["items"]:
                    print_record(item)
    ok = all(entry["status"] in {"authenticated", "ok"} and
             entry.get("after_restart", "authenticated") == "authenticated" for entry in results.values())
    return 0 if ok else 1


